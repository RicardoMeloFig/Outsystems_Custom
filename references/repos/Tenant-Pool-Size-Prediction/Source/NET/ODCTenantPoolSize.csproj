  <ItemGroup>
    <PackageReference Include="Microsoft.ML" Version="5.0.0" />
    <PackageReference Include="Microsoft.ML.TimeSeries" Version="5.0.0" />
    <!-- MathNet.Numerics powers the SARIMA / SARIMAX implementation (linear algebra and the
         Nelder-Mead simplex). Microsoft.ML does not transitively pull this in, so SARIMA needs
         it as a direct dependency. -->
    <PackageReference Include="MathNet.Numerics" Version="5.0.0" />
  </ItemGroup>
  <!--
    Legacy .csproj files do not flow the native (P/Invoke) runtime files of NuGet packages into
    the output folder. Microsoft.ML's SSA forecaster calls into MklImports.dll and CpuMathNative.dll
    via P/Invoke, so without this target the runtime fails with "Unable to load DLL 'MklImports'".

    The block below resolves the natives from the restored package cache and copies them next to
    the managed assembly. The OutSystems platform server runs as a 64-bit process — both
    OutSystems' own documentation and forum guidance confirm "All supported Windows versions in
    OutSystems are 64-bit, and IIS configuration typically supports only 64-bit C++ assemblies"
    (forum thread 45647). The platform DLLs in bin\ are AnyCPU managed assemblies whose PE Machine
    field is i386 only as the legacy CIL marker; that does not constrain the host bitness. Hence
    we ship the win-x64 natives. Loading 32-bit natives into the 64-bit CLR fails at runtime with
    BadImageFormatException (HRESULT 0x8007000B), which is what we observed before this change.

    The Windows DLL loader searches the application's working directory and PATH; it does not
    descend into subfolders of bin\, which is why we copy the natives directly into $(OutputPath)
    rather than into $(OutputPath)x64\ or similar.
  -->
  <Target Name="CopyMlNativeRuntimes" AfterTargets="Build">
    <ItemGroup>
      <_MlNative Include="$(NuGetPackageRoot)microsoft.ml.mkl.redist\5.0.0\runtimes\win-x64\native\*.dll" />
      <_MlNative Include="$(NuGetPackageRoot)microsoft.ml.cpumath\5.0.0\runtimes\win-x64\nativeassets\netstandard2.0\*.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(_MlNative)" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="true" />
    <Message Importance="high" Text="Copied @(_MlNative->Count()) win-x64 ML.NET native runtime files into $(OutputPath)." />
  </Target>
  <!--
    The Microsoft.ML 5.0.0 package bundles trainer assemblies (KMeans, PCA, StandardTrainers,
    etc.) in its own lib\ folder. The SSA-based forecaster does not use any of them — verified
    by a reachability walk over OutSystems.NssODCTenantPoolSize.dll's transitive references —
    so we filter them out of the build's CopyLocal set before MSBuild deploys them. Removing
    them from ReferenceCopyLocalPaths (rather than deleting them after the fact) keeps the
    project's FileListAbsolute.txt manifest in sync, which is essential because Integration
    Studio's packaging step reads that manifest and fails loudly on missing files.

    If a future implementation introduces a trainer (e.g. logistic regression for an ensemble
    step), remove the matching entry from the list below.
  -->
  <Target Name="ExcludeUnusedMlAssemblies" BeforeTargets="_CopyFilesMarkedCopyLocal;ResolveAssemblyReferences">
    <ItemGroup>
      <_UnusedMlNames Include="Microsoft.ML.KMeansClustering.dll" />
      <_UnusedMlNames Include="Microsoft.ML.PCA.dll" />
      <_UnusedMlNames Include="Microsoft.ML.StandardTrainers.dll" />
      <ReferenceCopyLocalPaths Remove="@(ReferenceCopyLocalPaths)" Condition="'%(FileName)%(Extension)' == 'Microsoft.ML.KMeansClustering.dll' or '%(FileName)%(Extension)' == 'Microsoft.ML.PCA.dll' or '%(FileName)%(Extension)' == 'Microsoft.ML.StandardTrainers.dll'" />
    </ItemGroup>
    <Message Importance="high" Text="Excluded @(_UnusedMlNames->Count()) unused ML.NET trainer assemblies from CopyLocal." />
  </Target>
  <!-- END FORECAST_DEPENDENCIES -->
