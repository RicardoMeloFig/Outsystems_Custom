# OutSystems UI Extractor - environment configuration
# Copy this file to ".env" and fill in your module name. The .env file is
# gitignored so your local module name never enters version control.
#
# The target module is resolved in priority order:
#   1. --module CLI flag            (highest)
#   2. OUTSYSTEMS_MODULE env var
#   3. OUTSYSTEMS_MODULE in .env    (lowest)
#
# Example:
# OUTSYSTEMS_MODULE=your-module-name

OUTSYSTEMS_MODULE=your-module-name
